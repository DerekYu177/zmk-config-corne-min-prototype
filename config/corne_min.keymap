#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500 // default 600

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&caps_word {
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB           &kp Q  &kp W  &kp E     &kp R  &kp T       &kp Y        &kp U  &kp I      &kp O    &kp P      &kp BSPC
&mt LCTRL ESCAPE  &kp A  &kp S  &kp D     &kp F  &kp G       &kp H        &kp J  &kp K      &kp L    &kp COLON  &kp ENTER
&kp LSHFT         &kp Z  &kp X  &kp C     &kp V  &kp B       &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH   &kp RIGHT_SHIFT
                                &kp LGUI  &mo 1  &kp LALT    &lt 4 SPACE  &mo 2  &mo 3
            >;
        };

        lower_layer {
            display-name = "Lower";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans     &trans             &trans     &kp GRAVE  &kp SEMI           &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp N7  &kp N8    &kp N9  &kp N0         &kp BSPC
&kp LCTRL  &kp LS(LG(LCTRL))  &kp MINUS  &kp EQUAL  &kp DOUBLE_QUOTES  &kp LEFT_BRACE      &kp RIGHT_BRACE    &kp N4  &kp N5    &kp N6  &trans         &kp ENTER
&kp LSHFT  &trans             &trans     &trans     &trans             &bootloader         &trans             &kp N1  &kp N2    &kp N3  &kp BACKSLASH  &kp RIGHT_SHIFT
                                         &kp LGUI   &trans             &kp LEFT_ALT        &kp SPACE          &trans  &kp RALT
            >;
        };

        raise_layer {
            display-name = "Raise";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &trans  &trans  &trans    &trans  &trans      &trans       &trans  &trans           &trans  &trans  &kp RC(BSPC)
&kp LCTRL  &trans  &trans  &trans    &trans  &trans      &trans       &trans  &trans           &trans  &trans  &kp SINGLE_QUOTE
&kp LSHFT  &trans  &trans  &trans    &trans  &trans      &bootloader  &trans  &trans           &trans  &trans  &kp RIGHT_SHIFT
                           &kp LGUI  &trans  &kp RALT    &kp SPACE    &trans  &kt RIGHT_SHIFT
            >;
        };

        misc {
            display-name = "Raise";
            bindings = <
&studio_unlock  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3  &trans      &kp C_BRIGHTNESS_INC  &kp C_VOLUME_UP    &trans  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK
&kp LCTRL       &trans        &trans        &kp BACKSPACE  &trans        &trans      &kp C_BRIGHTNESS_DEC  &kp C_VOLUME_DOWN  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
&kp LSHIFT      &bt BT_CLR    &trans        &trans         &trans        &trans      &trans                &kp K_MUTE         &trans  &trans          &trans          &trans
                                            &kp LGUI       &trans        &kp RALT    &kp SPACE             &trans             &trans
            >;
        };

        arrows {
            bindings = <
&trans          &trans  &trans  &trans    &trans  &trans      &trans    &trans    &trans  &trans     &trans  &trans
&kp LCTRL       &trans  &trans  &trans    &trans  &trans      &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&kp LEFT_SHIFT  &trans  &trans  &trans    &trans  &trans      &trans    &trans    &trans  &trans     &trans  &trans
                                &kp LGUI  &trans  &kp LALT    &trans    &trans    &trans
            >;
        };
    };
};
